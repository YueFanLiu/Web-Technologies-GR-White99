# Access4All environment variables.
# Copy this file to .env for local development or configure the same variables
# in the remote deployment platform.

SERVER_PORT=9192

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ISSUER_URI=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_IMAGES_BUCKET=images
SUPABASE_MAX_IMAGE_SIZE_BYTES=2097152

# PostgreSQL
DB_URL=jdbc:postgresql://your-db-host:6543/postgres?prepareThreshold=0
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password
MAIL_HEALTH_ENABLED=false

# JPA logging
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Frontend build/runtime values
VITE_APP_TITLE=Access4All
VITE_APP_BASE_API=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
